{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "@potential-guide/check-environment#verify": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "@potential-guide/check-environment#build": {
      "dependsOn": ["^build"],
      "env": ["PGUIDE_ENVIRONMENT_BINARY_INPUTS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/task-protocol/src/**",
        "$TURBO_ROOT$/packages/pguide-task-bundle/src/**",
        "$TURBO_ROOT$/packages/check-sdk/src/authoring.ts",
        "$TURBO_ROOT$/scripts/environment-cache-inputs.mjs"
      ],
      "outputs": [
        "dist/*.js",
        "dist/*.d.ts",
        "dist/*.map",
        "dist/tasks/**",
        "dist/definitions/**",
        "dist/staging/**",
        "dist/candidate/**"
      ]
    },
    "@potential-guide/check-sdk#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "examples/text/dist/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@potential-guide/cli-core#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/schemas/agents/v1.json",
        "$TURBO_ROOT$/scripts/build-agents-schema.mjs",
        "$TURBO_ROOT$/scripts/build-settings.mjs",
        "$TURBO_ROOT$/packages/*/settings.json",
        "$TURBO_ROOT$/packages/*/package.json"
      ],
      "outputs": ["dist/**", "src/built-in-settings.ts"]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@potential-guide/objective-package-standard#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/objective-monorepo-standard/src/**",
        "$TURBO_ROOT$/packages/objective-monorepo-standard/objective.yaml",
        "$TURBO_ROOT$/packages/objective-monorepo-standard/check.mjs",
        "$TURBO_ROOT$/packages/objective-monorepo-standard/package.json",
        "$TURBO_ROOT$/scripts/build-*.mjs",
        "$TURBO_ROOT$/scripts/build-monorepo-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-evidence-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-objective-package.mjs",
        "$TURBO_ROOT$/scripts/build-check-workers.mjs"
      ],
      "outputs": ["dist/**", "$TURBO_ROOT$/.staging/objective-package-standard/**"]
    },
    "@potential-guide/objective-setup-marker#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-*.mjs",
        "$TURBO_ROOT$/scripts/build-objective-package.mjs",
        "$TURBO_ROOT$/scripts/build-check-workers.mjs"
      ],
      "outputs": ["dist/**", "$TURBO_ROOT$/.staging/objective-setup-marker/**"]
    },
    "@potential-guide/objective-pguide-self-check#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-*.mjs",
        "$TURBO_ROOT$/scripts/build-self-check-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-evidence-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-objective-package.mjs",
        "$TURBO_ROOT$/scripts/build-check-workers.mjs",
        "$TURBO_ROOT$/scripts/self-check-agent.mjs"
      ],
      "outputs": ["dist/**", "$TURBO_ROOT$/.staging/objective-pguide-self-check/**"]
    },
    "@potential-guide/objective-monorepo-standard#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-*.mjs",
        "$TURBO_ROOT$/scripts/build-monorepo-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-objective-package.mjs",
        "$TURBO_ROOT$/scripts/build-check-workers.mjs",
        "$TURBO_ROOT$/scripts/build-evidence-runtime.mjs"
      ],
      "outputs": ["dist/**", "$TURBO_ROOT$/.staging/objective-monorepo-standard/**"]
    },
    "@potential-guide/objective-monorepo-standard#test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "@potential-guide/objective-devbox-health#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-*.mjs",
        "$TURBO_ROOT$/scripts/build-health-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-evidence-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-objective-package.mjs",
        "$TURBO_ROOT$/scripts/build-check-workers.mjs"
      ],
      "outputs": ["dist/**", "$TURBO_ROOT$/.staging/objective-devbox-health/**"]
    },
    "@potential-guide/objective-pguide-setup#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-*.mjs",
        "$TURBO_ROOT$/scripts/build-setup-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-evidence-runtime.mjs",
        "$TURBO_ROOT$/scripts/build-objective-package.mjs",
        "$TURBO_ROOT$/scripts/build-check-workers.mjs"
      ],
      "outputs": ["dist/**", "$TURBO_ROOT$/.staging/objective-pguide-setup/**"]
    },
    "pguide#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "@potential-guide/objective-pguide-setup#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-pilot-sources.mjs"],
      "outputs": []
    },
    "@potential-guide/objective-pguide-self-check#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-pilot-sources.mjs"],
      "outputs": []
    },
    "@potential-guide/objective-devbox-health#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-pilot-sources.mjs"],
      "outputs": []
    }
  }
}
