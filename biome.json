{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.cache",
      "!**/.turbo",
      "!**/dist",
      "!**/node_modules",
      "!.silvermoon",
      "!packages/objective-monorepo-standard/runtime",
      "!packages/objective-pguide-self-check/runtime",
      "!packages/objective-devbox-health/runtime",
      "!packages/objective-pguide-setup/runtime"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
