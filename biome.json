{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.cache",
      "!**/.turbo",
      "!**/dist",
      "!**/node_modules",
      "!.silvermoon",
      "!packages/pguide-self-check-pilot/runtime",
      "!packages/development-machine-health-pilot/runtime",
      "!packages/pguide-setup-pilot/runtime"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
