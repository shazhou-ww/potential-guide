{
  "name": "@potential-guide/task-engine-web-ui",
  "version": "0.1.0",
  "description": "Local HTTP task workbench and packaged browser assets.",
  "exports": {
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    }
  },
  "files": [
    "dist/src",
    "dist/public",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "apps/task-engine-web-ui"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs && tailwindcss -i src/style.css -o dist/public/style.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "start": "node dist/src/main.js",
    "fixture": "tsx fixture/main.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@tanstack/react-table": "catalog:",
    "@potential-guide/task-protocol": "workspace:^",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "get-nonce": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@potential-guide/task-sdk": "workspace:^",
    "@potential-guide/task-engine": "workspace:^",
    "@potential-guide/task-engine-server": "workspace:^",
    "@tailwindcss/cli": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "linkedom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "@types/node": "catalog:",
    "@potential-guide/pguide-task-bundle": "workspace:^"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
