{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shazhou-ww.github.io/potential-guide/schemas/artifacts/task/v2.json",
  "$comment": "Task Worker v2: v1 business messages plus independent log/log-ack and bounded cumulative log-drop/log-drop-ack diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "name",
    "runtime",
    "entry",
    "inputSchema",
    "resultSchema",
    "messageSchema"
  ],
  "properties": {
    "$schema": {
      "const": "https://shazhou-ww.github.io/potential-guide/schemas/artifacts/task/v2.json"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f](?:(?:[^\\s\\u0000-\\u001f\\u007f-\\u009f]| )*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minVersion"],
      "properties": {
        "type": { "const": "node" },
        "minVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "entry": { "const": "worker.cjs" },
    "inputSchema": { "type": "object" },
    "resultSchema": { "type": ["object", "boolean"] },
    "messageSchema": { "type": ["object", "boolean"] }
  }
}
