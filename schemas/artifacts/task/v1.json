{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shazhou-ww.github.io/potential-guide/schemas/artifacts/task/v1.json",
  "$comment": "IPFS UnixFS directory root CID identity. One CommonJS Worker per Run; generation-scoped business messages and independent log/log-ack, bounded cumulative log-drop/log-drop-ack diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "name",
    "runtime",
    "entry",
    "include",
    "binary",
    "inputSchema",
    "resultSchema",
    "messageSchema"
  ],
  "properties": {
    "$schema": {
      "const": "https://shazhou-ww.github.io/potential-guide/schemas/artifacts/task/v1.json"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f](?:(?:[^\\s\\u0000-\\u001f\\u007f-\\u009f]| )*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minVersion"],
      "properties": {
        "type": { "const": "node" },
        "minVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "entry": { "const": "worker.cjs" },
    "include": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:task\\.yaml|worker\\.cjs|(?:schemas|resources)/[^\\\\:*?<>|\\u0000-\\u001f]+)$"
      }
    },
    "inputSchema": { "type": "object" },
    "binary": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^resources/[^\\\\:*?<>|\\u0000-\\u001f]+$" }
    },
    "resultSchema": { "type": ["object", "boolean"] },
    "messageSchema": { "type": ["object", "boolean"] }
  }
}
