{
  "name": "@potential-guide/pguide-task-bundle",
  "version": "0.1.0-rc.2",
  "description": "Offline TypeBox Task Bundle authoring and CAR inspection for pguide.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js"
    },
    "./bin/task-bundle": {
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./artifact": {
      "types": "./dist/artifact.d.ts",
      "import": "./dist/artifact.js"
    },
    "./car": {
      "types": "./dist/car.d.ts",
      "import": "./dist/car.js"
    }
  },
  "bin": {
    "pguide-task-bundle": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"for (const path of ['dist', '../../.cache/tsbuildinfo/pguide-task-bundle.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/cli-core": "workspace:^",
    "@potential-guide/task-protocol": "workspace:^",
    "@potential-guide/task-sdk": "workspace:^",
    "@sinclair/typebox": "catalog:",
    "ajv": "catalog:",
    "esbuild": "catalog:",
    "multiformats": "catalog:",
    "semver": "catalog:",
    "@helia/unixfs": "catalog:",
    "@helia/car": "catalog:",
    "@ipld/car": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "@libp2p/logger": "catalog:",
    "blockstore-core": "catalog:",
    "ipfs-unixfs-exporter": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/semver": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/pguide-task-bundle"
  }
}
