{
  "name": "@potential-guide/probe-sdk",
  "private": true,
  "version": "0.1.0-rc.0",
  "description": "Two-stage Probe Task authoring and independent Check composition.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "import": "./dist/execution.js"
    },
    "./publication": {
      "types": "./dist/publication.d.ts",
      "import": "./dist/publication.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false",
    "objectives:build": "pnpm run build && node ../../scripts/build.mjs --filter=@potential-guide/check-environment... && node ../../scripts/run-probe-objectives.mjs build",
    "objectives:run": "node ../../scripts/run-probe-objectives.mjs run",
    "objectives:local": "pnpm run objectives:build && node ../../scripts/run-probe-objectives.mjs run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/check-sdk": "workspace:^",
    "@potential-guide/ipfs-content": "workspace:^",
    "@silvermoon-work/task-protocol": "catalog:",
    "@silvermoon-work/task-sdk": "catalog:",
    "@sinclair/typebox": "catalog:",
    "multiformats": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@potential-guide/task-authoring": "workspace:^",
    "@silvermoon-work/task-engine": "catalog:",
    "@silvermoon-work/task-engine-http": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/probe-sdk"
  }
}
