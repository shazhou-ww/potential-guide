{
  "name": "@potential-guide/monorepo-objective",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only, requirements-led pnpm monorepo Objective checks.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "ajv": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
