{
  "name": "pguide",
  "version": "0.3.0-rc.0",
  "description": "Extensible command-line interface for Potential Guide.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "pguide": "./dist/bin.js",
    "pguide-continue": "./dist/bin/continue.js",
    "pguide-probe": "./dist/bin/probe.js",
    "pguide-regulate": "./dist/bin/regulate.js",
    "pguide-scaffold": "./dist/bin/scaffold.js",
    "pguide-supervise": "./dist/bin/supervise.js",
    "pguide-validate": "./dist/bin/validate.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/cli-core": "workspace:^",
    "@potential-guide/objective-pilot": "workspace:^",
    "@potential-guide/effects": "workspace:^",
    "@potential-guide/git-source": "workspace:^",
    "@potential-guide/objective-regulator": "workspace:^",
    "@potential-guide/objective-portfolio-supervisor": "workspace:^",
    "@potential-guide/config": "workspace:^",
    "cross-spawn": "catalog:"
  },
  "devDependencies": {
    "@types/cross-spawn": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/pguide"
  }
}
