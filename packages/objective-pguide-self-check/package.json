{
  "name": "@potential-guide/objective-pguide-self-check",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free snapshot delivery of the local pguide self-check Pilot.",
  "type": "module",
  "files": [
    "objective.yaml",
    "checks",
    "references",
    "runtime",
    "self-check.mjs"
  ],
  "exports": {
    "./objective.yaml": "./objective.yaml"
  },
  "scripts": {
    "build": "node ../../scripts/build-self-check-runtime.mjs",
    "clean": "node -e \"\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.mjs\"",
    "typecheck": "node ../../scripts/check-pilot-sources.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@potential-guide/objective-pguide-setup": "workspace:^",
    "@potential-guide/cli-core": "workspace:^",
    "pguide": "workspace:^"
  }
}
