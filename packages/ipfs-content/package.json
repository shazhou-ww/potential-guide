{
  "name": "@potential-guide/ipfs-content",
  "private": true,
  "version": "0.1.0-rc.0",
  "description": "Bounded policy adapters for official Helia UnixFS, IPLD CAR and verified Gateway reads.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./read": {
      "types": "./dist/read.d.ts",
      "import": "./dist/read.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./publish": {
      "types": "./dist/publish.d.ts",
      "import": "./dist/publish.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@helia/unixfs": "catalog:",
    "@helia/car": "catalog:",
    "@ipld/car": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "@libp2p/logger": "catalog:",
    "blockstore-core": "catalog:",
    "kubo-rpc-client": "catalog:",
    "ipfs-unixfs-exporter": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "multiformats": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/ipfs-content"
  }
}
