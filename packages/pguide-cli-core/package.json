{
  "name": "@potential-guide/cli-core",
  "pguide": {
    "settings": "./settings.json"
  },
  "version": "0.3.0-rc.0",
  "description": "Shared CLI protocol, configuration, persistence, and ACP/AHP clients for Potential Guide.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./schemas/agents/v1.json": "./dist/schemas/agents/v1.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "settings.json",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-settings.mjs && tsc -b && node ../../scripts/build-agents-schema.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "catalog:",
    "ajv": "catalog:",
    "jsonc-parser": "catalog:",
    "yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/pguide-cli-core"
  }
}
