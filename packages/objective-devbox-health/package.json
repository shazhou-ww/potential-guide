{
  "name": "@potential-guide/objective-devbox-health",
  "version": "0.1.0",
  "description": "Complete Linux development-machine health Pilot with bounded Docker transport.",
  "type": "module",
  "files": [
    "objective.yaml",
    "checks",
    "references",
    "observation-inputs.json"
  ],
  "exports": {
    "./objective.yaml": "./objective.yaml"
  },
  "scripts": {
    "build": "node ../../scripts/build-objective-package.mjs objective-devbox-health",
    "clean": "node -e \"\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "node ../../scripts/check-pilot-sources.mjs"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist/package"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@potential-guide/effects": "workspace:^",
    "@potential-guide/objective-pilot": "workspace:^"
  }
}
