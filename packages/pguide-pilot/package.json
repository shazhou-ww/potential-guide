{
  "name": "@potential-guide/pguide-pilot",
  "version": "0.4.0-rc.0",
  "description": "@potential-guide/pguide-pilot for Potential Guide.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./bin/probe": {
      "types": "./dist/bin/probe.d.ts",
      "import": "./dist/bin/probe.js"
    },
    "./bin/scaffold": {
      "types": "./dist/bin/scaffold.d.ts",
      "import": "./dist/bin/scaffold.js"
    },
    "./bin/validate": {
      "types": "./dist/bin/validate.d.ts",
      "import": "./dist/bin/validate.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "node --test",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/cli-core": "workspace:^",
    "@potential-guide/cli-runtime": "workspace:^",
    "@potential-guide/effects": "workspace:^",
    "@potential-guide/objective-pilot": "workspace:^",
    "@potential-guide/pilot-protocol": "workspace:^",
    "@potential-guide/objective-declarations": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/pguide-pilot"
  },
  "bin": {
    "pguide-probe": "./dist/bin/probe.js",
    "pguide-scaffold": "./dist/bin/scaffold.js",
    "pguide-validate": "./dist/bin/validate.js"
  }
}
