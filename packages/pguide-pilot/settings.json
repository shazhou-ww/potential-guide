{
  "schemaVersion": 1,
  "namespace": "pilot",
  "settings": {
    "pilot.reportsEnabled": {
      "description": "Enable probe/regulate reports.",
      "schema": { "type": "boolean" },
      "default": true
    },
    "pilot.reportDirectory": {
      "description": "Report directory relative to effective cwd; absent means reports under the resolved state root.",
      "schema": { "type": "string", "pattern": "\\S" }
    },
    "pilot.probe": {
      "description": "Probe budgets and Regulation retry. timeoutMs retains the Regulation outer probe deadline and legacy check fallback; checkTimeoutMs overrides the single-check deadline. preparationTimeoutMs covers each source preparation; observationBudget is shared by the complete dependency observation, including lazy preparation. Supervise workers retain their archived policy.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeoutMs", "retry"],
        "properties": {
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "checkTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "preparationTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "observationBudget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timeoutMs", "maxDepth", "maxObservations"],
            "properties": {
              "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
              "maxDepth": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "maxObservations": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
            }
          },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxRetries", "delayMs"],
            "properties": {
              "maxRetries": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "delayMs": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
            }
          }
        }
      },
      "default": { "timeoutMs": 30000, "retry": { "maxRetries": 0, "delayMs": 0 } }
    }
  }
}
