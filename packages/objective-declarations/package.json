{
  "name": "@potential-guide/objective-declarations",
  "version": "0.1.0-rc.0",
  "description": "Shared tool-side Objective declaration selection and subject binding.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "node --test",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "npm-package-arg": "catalog:",
    "@potential-guide/cli-core": "workspace:^",
    "@potential-guide/pilot-protocol": "workspace:^"
  },
  "devDependencies": {
    "@types/npm-package-arg": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/objective-declarations"
  }
}
