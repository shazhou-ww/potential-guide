{
  "name": "@potential-guide/objective-guide",
  "version": "0.2.0-rc.0",
  "description": "Language-neutral objective definitions, observations, and localized guidance.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "pguide-probe": "./dist/bin/probe.js",
    "pguide-scaffold": "./dist/bin/scaffold.js",
    "pguide-validate": "./dist/bin/validate.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/cli-core": "workspace:^",
    "ajv": "catalog:",
    "jsonata": "catalog:",
    "yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/objective-guide"
  }
}
