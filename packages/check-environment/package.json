{
  "name": "@potential-guide/check-environment",
  "version": "0.2.0-rc.0",
  "description": "Reusable tool version, directory and network checks delivered as standalone Task Bundles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.map",
    "dist/tasks",
    "dist/definitions",
    "dist/bundles",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs --candidate",
    "verify": "node verify.mjs",
    "prepack": "node verify.mjs --accepted",
    "clean": "node -e \"for (const path of ['dist', '../../.cache/tsbuildinfo/check-environment.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "node prepare.mjs && tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/check-sdk": "workspace:^",
    "@sinclair/typebox": "catalog:"
  },
  "devDependencies": {
    "@potential-guide/task-sdk": "workspace:^",
    "@potential-guide/task-engine": "workspace:^",
    "@potential-guide/task-protocol": "workspace:^",
    "@potential-guide/pguide-task-bundle": "workspace:^",
    "yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/check-environment"
  }
}
