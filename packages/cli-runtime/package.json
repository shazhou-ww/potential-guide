{
  "name": "@potential-guide/cli-runtime",
  "version": "0.1.0-rc.0",
  "description": "@potential-guide/cli-runtime for Potential Guide.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "node --test",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/objective-host": "workspace:^",
    "@potential-guide/check-artifacts": "workspace:^",
    "ajv": "catalog:",
    "@potential-guide/checker-host": "workspace:^",
    "@potential-guide/cli-core": "workspace:^",
    "@potential-guide/effects": "workspace:^",
    "@potential-guide/git-source": "workspace:^",
    "@potential-guide/objective-pilot": "workspace:^",
    "@potential-guide/pilot-protocol": "workspace:^",
    "npm-package-arg": "catalog:",
    "pacote": "catalog:",
    "tar": "catalog:",
    "@npmcli/arborist": "catalog:",
    "@npmcli/run-script": "catalog:",
    "npm-packlist": "catalog:"
  },
  "devDependencies": {
    "@types/npm-package-arg": "catalog:",
    "@types/pacote": "catalog:",
    "@types/npmcli__arborist": "catalog:",
    "@types/npm-packlist": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/cli-runtime"
  }
}
