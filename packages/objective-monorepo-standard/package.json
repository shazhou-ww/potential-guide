{
  "name": "@potential-guide/objective-monorepo-standard",
  "version": "0.1.0",
  "description": "Read-only, requirements-led pnpm monorepo Objective checks.",
  "type": "module",
  "files": [
    "objective.yaml",
    "observation-inputs.json",
    "checks",
    "references",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    "./objective.yaml": "./objective.yaml"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-objective-package.mjs objective-monorepo-standard",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test --test-concurrency=1 \"test/*.test.ts\" \"test/*.test.mjs\"",
    "typecheck": "tsc -b --pretty false"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist/package"
  },
  "license": "MIT",
  "objectiveDependencies": [
    "@potential-guide/objective-package-standard"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/objective-package-standard": "workspace:^",
    "@potential-guide/objective-pilot": "workspace:^",
    "ajv": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@potential-guide/effects": "workspace:^",
    "@potential-guide/objective-regulator": "workspace:^",
    "pguide": "workspace:^"
  }
}
