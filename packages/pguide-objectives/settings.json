{
  "schemaVersion": 1,
  "namespace": "objectives",
  "settings": {
    "objectives.aliases": {
      "description": "Legacy source aliases only; does not replace independent Objective declarations.",
      "schema": {
        "type": "object",
        "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "additionalProperties": { "type": "string", "pattern": "\\S", "not": { "pattern": "^@" } }
      },
      "default": {}
    }
  }
}
