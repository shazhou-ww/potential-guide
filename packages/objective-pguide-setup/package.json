{
  "name": "@potential-guide/objective-pguide-setup",
  "version": "0.1.0",
  "description": "Complete local and SSH pguide setup Pilot.",
  "type": "module",
  "files": [
    "objective.yaml",
    "checks",
    "references",
    "README.md"
  ],
  "exports": {
    "./objective.yaml": "./objective.yaml"
  },
  "scripts": {
    "build": "node ../../scripts/build-objective-package.mjs objective-pguide-setup",
    "clean": "node -e \"\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "node ../../scripts/check-pilot-sources.mjs"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist/package"
  },
  "license": "MIT",
  "objectiveDependencies": [
    "@potential-guide/objective-setup-marker"
  ],
  "dependencies": {
    "@potential-guide/objective-setup-marker": "workspace:^"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@potential-guide/objective-pilot": "workspace:^",
    "@potential-guide/pguide-config": "workspace:^",
    "pguide": "workspace:^"
  }
}
