{
  "name": "@potential-guide/pguide-regulate",
  "pguide": {
    "settings": "./settings.json"
  },
  "version": "0.4.0-rc.0",
  "description": "@potential-guide/pguide-regulate for Potential Guide.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "settings.json",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "node --test",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@potential-guide/cli-core": "workspace:^",
    "@potential-guide/cli-runtime": "workspace:^",
    "@potential-guide/effects": "workspace:^",
    "@potential-guide/objective-pilot": "workspace:^",
    "@potential-guide/objective-regulator": "workspace:^",
    "@potential-guide/objective-declarations": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/potential-guide.git",
    "directory": "packages/pguide-regulate"
  },
  "bin": {
    "pguide-regulate": "./dist/bin/regulate.js",
    "pguide-continue": "./dist/bin/continue.js"
  }
}
